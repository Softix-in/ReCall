# Copy to .env and fill in before: docker compose up -d

# Strong random key — required for any public/hosted deployment
RECALL_API_KEY=change-me-to-a-long-random-string

# Host port exposed on the server
RECALL_PORT=7878

# CORS (optional). Use * for development or list origins comma-separated.
RECALL_CORS_ORIGINS=*

# Set true when running behind nginx, Caddy, or a cloud load balancer
TRUST_PROXY=false

# Fireworks AI API key (optional — used by Identity & Career module in Step 3+)
FIREWORKS_API_KEY=

# PDF export (Step 4) — optional Puppeteer overrides
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
