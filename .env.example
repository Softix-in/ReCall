# Copy to .env and fill in before: docker compose up -d

# PostgreSQL (required). Use a strong unique password in production.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://recall:changeme@postgres:5432/recall

# JWT RS256 key pair (required when AUTH_LEGACY_API_KEY=false)
# Generate with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Paste PEM contents or use \n-escaped single-line values
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=recall
JWT_AUDIENCE=recall-api

# AES key for Fireworks API keys at rest (32+ random bytes, hex or any secret)
ENCRYPTION_KEY=

# Legacy shared API key — set true only during extension migration window
RECALL_API_KEY=
AUTH_LEGACY_API_KEY=false
AUTH_ALLOW_REGISTRATION=true
BOOTSTRAP_USER_EMAIL=bootstrap@recall.local

# Host port exposed on the server. Prefer 127.0.0.1 plus Caddy TLS in production.
RECALL_BIND=127.0.0.1
RECALL_PORT=7878

# CORS. Use "extension" (chrome-extension + localhost) or an explicit origin list.
# Do not use * in production.
RECALL_CORS_ORIGINS=extension

# Set true when running behind Caddy, nginx, or a cloud load balancer
TRUST_PROXY=false

# Fireworks AI API key (optional). Shared env key is off unless explicitly enabled.
FIREWORKS_API_KEY=
FIREWORKS_ALLOW_SHARED_KEY=false

# Firecrawl API key (required for document extraction and docs crawl)
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CRAWL_PAGES=25
RESEARCH_MAX_CRAWL_PAGES=12
RESEARCH_MAX_SEARCH_RESULTS=5
DOC_EXTRACT_MIN_CLIENT_CHARS=800

# Cloudflare R2 object storage (optional — falls back to local RECALL_HOME)
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Public URL for email links (verify, reset, change email). Use https in production.
PUBLIC_BASE_URL=http://127.0.0.1:7878

# SMTP (required for real emails in production)
# Gmail example: smtp.gmail.com, port 587, SMTP_SECURE=false, use App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recall <noreply@yourdomain.com>

# Log verification/reset links to server console when SMTP is not configured.
# Never enable this on a public host — tokens must not appear in API responses.
EMAIL_DEV_LOG=false

# Optional TLS reverse proxy: docker compose --profile tls up -d
# RECALL_DOMAIN=recall.example.com
# CADDY_EMAIL=you@example.com

# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
