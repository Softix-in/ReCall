{
  "name": "backend",
  "version": "0.6.0",
  "description": "recall local backend daemon",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "inspect-db": "node scripts/inspect-db.js",
    "test:phase1": "node scripts/test-phase1.js",
    "test:phase2": "node scripts/test-phase2.js",
    "test:phase3": "node scripts/test-phase3.js",
    "test:phase4": "node scripts/test-phase4.js",
    "test:phase5": "node scripts/test-phase5.js",
    "benchmark:search": "node scripts/benchmark-search.js",
    "clear:test-data": "node scripts/clear-test-data.js",
    "test:classify": "node scripts/test-classify.js",
    "test:identity-career-step1": "node scripts/test-identity-career-step1.js",
    "test:identity-career-step3": "node scripts/test-identity-career-step3.js",
    "test:identity-career-step4": "node scripts/test-identity-career-step4.js",
    "test:identity-career-step5": "node scripts/test-identity-career-step5.js",
    "test:identity-career": "node scripts/test-identity-career-step1.js && node scripts/test-identity-career-step3.js && node scripts/test-identity-career-step4.js && node scripts/test-identity-career-step5.js",
    "backfill:embeddings": "node scripts/backfill-embeddings.js",
    "setup:embed": "powershell -ExecutionPolicy Bypass -File scripts/setup-embed.ps1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "jsdom": "^25.0.1",
    "node-cron": "^4.2.1",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.36.1",
    "express-rate-limit": "^8.2.1"
  }
}
